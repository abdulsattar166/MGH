# VITE_PUBLIC_API_URL=http://localhost:4000/api
# Set to "true" to skip the management login (everyone enters as Super Admin).
VITE_AUTH_DISABLED=false

# The Supabase values below are only needed when running against Supabase
# (the default). If VITE_PUBLIC_API_URL is set, the app talks to the local
# Node/Express + MySQL backend instead.
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=